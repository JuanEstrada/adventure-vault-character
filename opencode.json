{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "dart": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    },
    "prettier": {
      "command": ["npx", "-y", "prettier", "--write", "$FILE"],
      "extensions": [".md"]
    },
    "ruff": {
      "command": ["uvx", "ruff", "format", "$FILE"],
      "extensions": [".py"]
    }
  }
}
